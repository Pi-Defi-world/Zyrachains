# Copy to .env.production with real values (never commit .env.production — secrets live there)

# Backend (Express server)
SERVER_URL=https://server.zyrachain.org
NEXT_PUBLIC_API_URL=https://server.zyrachain.org
NEXT_PUBLIC_SERVER_URL=https://server.zyrachain.org
NEXT_PUBLIC_LOCAL_SERVER_URL=http://localhost:4111
LOCAL_SERVER_URL=http://localhost:4111

# Oracle (price feed)
NEXT_PUBLIC_ORACLE_URL=https://api.zyrachain.org

# App / metadata
NEXT_PUBLIC_BASE_URL=https://testnet.zyrachain.org

# Horizon
NEXT_PUBLIC_HORIZON_BASE_URL=https://api.testnet.minepi.com
NEXT_PUBLIC_HORIZON_URL=https://api.testnet.minepi.com
NEXT_PUBLIC_HORIZON_FALLBACK_URL=https://api.zyrachain.org/horizon

# Pi Network
NEXT_PUBLIC_PI_SANDBOX=true
PI_NETWORK_APP_ID=
PI_NETWORK_REDIRECT_URI=https://testnet.zyrachain.org/api/pi/auth/callback
PI_API_KEY=

# Image uploads — REQUIRED on Vercel (local filesystem is read-only there)
# Add the token from Vercel → Storage → Blob. IMAGE_STORAGE=vercel-blob is
# auto-selected whenever BLOB_READ_WRITE_TOKEN is present.
BLOB_READ_WRITE_TOKEN=

# MongoDB (used by Next.js API routes that read/write listings, contact, reports)
MONGODB_URI=