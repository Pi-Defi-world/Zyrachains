# Zyrachain frontend environment variables
# Copy to .env for local dev, and to .env.production for production builds (never commit .env.production)

# Zyrachain Express API (must match browser origin / CORS)
NEXT_PUBLIC_API_URL=http://localhost:4111
LOCAL_SERVER_URL=http://localhost:4111
NEXT_PUBLIC_LOCAL_SERVER_URL=http://localhost:4111

# Production backend override (uncomment for production)
# SERVER_URL=https://server.zyrachain.org
# NEXT_PUBLIC_SERVER_URL=https://server.zyrachain.org

# Oracle / price feed (production)
# NEXT_PUBLIC_ORACLE_URL=https://api.zyrachain.org

# App base URL for metadata
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Horizon (blockchain reads) — Suban API service
NEXT_PUBLIC_HORIZON_BASE_URL=https://horizon.suban.org/horizon
NEXT_PUBLIC_HORIZON_URL=https://horizon.suban.org/horizon
NEXT_PUBLIC_HORIZON_FALLBACK_URL=https://horizon.suban.org/horizon
NEXT_PUBLIC_TESTNET_HORIZON_URL=https://testnet.suban.org
NEXT_PUBLIC_ORACLE_URL=https://oracle.suban.org
NEXT_PUBLIC_RPC_MAINNET_URL=https://rpc.suban.org
NEXT_PUBLIC_RPC_TESTNET_URL=https://testrpc.suban.org

# Pi Network connectivity
NEXT_PUBLIC_PI_SANDBOX=true
PI_NETWORK_APP_ID=
PI_NETWORK_REDIRECT_URI=http://localhost:8000/api/pi/auth/callback

# Image uploads (avatars, post images)
# Local storage is used in dev. In production (Vercel) set BLOB_READ_WRITE_TOKEN
# to store uploads in Vercel Blob — the local filesystem is read-only on Vercel.
BLOB_READ_WRITE_TOKEN=
# IMAGE_STORAGE=vercel-blob   # optional; auto-selected when BLOB_READ_WRITE_TOKEN is set

# Override automatic local/remote detection (defaults to local in dev)
# FORCE_REMOTE_BACKEND=true
# NEXT_PUBLIC_FORCE_REMOTE_BACKEND=true
# FORCE_LOCAL_BACKEND=true
# NEXT_PUBLIC_FORCE_LOCAL_BACKEND=true