# Copy to .env and fill in real values (never commit .env)

# Server
NODE_ENV=production
SERVER_PORT=4000

# Database
MONGODB_URI=your-mainnet-mongodb-uri
MONGODB_DB=zyrachain_mainnet

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=change-me

# Pi Network (mainnet)
PI_NETWORK_API_KEY=
PI_NETWORK_APP_ID=
PI_API_KEY=
PI_ENV=mainnet
PI_SANDBOX_MODE=false
PI_NETWORK_WALLET_ADDRESS=
PI_WALLET_PRIVATE_SEED=
PI_NETWORK_REDIRECT_URI=https://zyrachain.org/api/pi/auth/callback

# URLs
FRONTEND_URL=https://zyrachain.org
APP_URL=https://server.zyrachain.org
SERVER_URL=https://server.zyrachain.org

# Suban API Service
PCT_HORIZON_BASE_URL=https://horizon.suban.org/horizon
HORIZON_BASE_URL=https://testnet.suban.org
HORIZON_FALLBACK_URL=https://horizon.suban.org/horizon

# Pi SDK config (OAuth/payment points to Pi directly)
PI_BACKEND_HORIZON_MAINNET_URL=https://api.minepi.com
PI_BACKEND_HORIZON_TESTNET_URL=https://api.testnet.minepi.com
PI_BACKEND_HORIZON_MAINNET_PASSPHRASE="Pi Network"
PI_BACKEND_HORIZON_TESTNET_PASSPHRASE="Pi Testnet"
PI_BACKEND_PLATFORM_BASE_URL=https://api.minepi.com
PI_NETWORK_API_BASE_URL=https://api.minepi.com

# Oracle
ORACLE_BASE_URL=https://oracle.suban.org

# PCT Scanner
PCT_SCAN_ENABLED=true
PCT_SCAN_CRON="*/15 * * * *"
PCT_HORIZON_TIMEOUT_MS=30000
SNAPSHOT_CRON_ENABLED=true

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Social metrics
TWITTER_BEARER_TOKEN=
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
SOCIAL_STATS_CACHE_TTL_MS=600000
