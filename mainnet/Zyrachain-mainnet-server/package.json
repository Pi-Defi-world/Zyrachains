{
  "name": "Zyrachain-server",
  "version": "1.0.0",
  "description": "Standalone server for Zyrachain Pi Network ecosystem hub",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:admin-api": "node test-admin-api.js",
    "test:addresses": "ts-node scripts/test-address-endpoints.ts",
    "db:sync-from-remote": "node scripts/sync-remote-to-local-mongodb.js",
    "db:migrate-dump-restore": "node scripts/mongodb-tools-migrate.js",
    "db:restore-local": "node scripts/mongodb-restore-local.js",
    "import:core-team-wallets": "ts-node scripts/import-core-team-wallets.ts",
    "pct:scan": "ts-node scripts/run-pct-balance-scan.ts",
    "diagnose:addresses": "ts-node scripts/diagnose-core-addresses.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.3",
    "redis": "4.7.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "pi-network",
    "blockchain",
    "api",
    "express",
    "typescript"
  ],
  "author": "Zyrachain Team",
  "license": "MIT"
}