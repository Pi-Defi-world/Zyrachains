# Copy to .env and fill in real values (never commit .env)

# Server
NODE_ENV=development
SERVER_PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/Zyrachain
# Optional: copy remote → local
# Recommended: pnpm run db:migrate-dump-restore (MongoDB Database Tools)
#   If tools are installed but not on PATH, set e.g.:
# MONGO_TOOLS_BIN=C:\Program Files\MongoDB\Tools\100\bin
# Alternative: pnpm run db:sync-from-remote (Node; if SRV/DNS fails use standard mongodb:// URI from Atlas)
# Restore existing .mongo-dump only (no Atlas): pnpm run db:restore-local
# MONGO_RESTORE_FROM=.mongo-dump/run-123   # optional; default = newest run-* folder
# SOURCE_MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/REMOTE_DB_NAME
# If you get querySrv ECONNREFUSED, use Atlas "standard" mongodb:// URI (not SRV) instead.
# If the URI has no /dbname, set the remote DB explicitly:
# SOURCE_DATABASE=infogram
# TARGET_DATABASE=Zyrachain
# LIST_SOURCE_DATABASES=1   # log DB names on cluster (needs permission)

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Pi Network (see Pi Developer Portal)
# PI_NETWORK_API_KEY is used by the rewarded-ads verification endpoint (and PI_API_KEY
# is read as a fallback). Must be set on the server for Pi Ads rewards to credit.
PI_NETWORK_API_KEY=
PI_NETWORK_APP_ID=
PI_ENV=sandbox
PI_SANDBOX_MODE=true
# Explicit platform API base (default: mainnet https://api.minepi.com; sandbox falls
# back to https://api.testnet.minepi.com). Set PI_PLATFORM_API_URL to override.
# PI_PLATFORM_API_URL=https://api.minepi.com

# URLs
# Local development:
FRONTEND_URL=http://localhost:8000
APP_URL=http://localhost:4111
# Production (Render + testnet.zyrachain.org):
# FRONTEND_URL=https://testnet.zyrachain.org
# APP_URL=https://zyrachain-server.onrender.com
# SERVER_URL=https://zyrachain-server.onrender.com

# Oracle service (price aggregation)
# Production: https://oracle.suban.org
# Local Docker: http://oracle:3000
ORACLE_BASE_URL=https://oracle.suban.org

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Live social metrics (optional — enables /api/social-stats and ?socialStats=1 on listings)
# X / Twitter API v2 app-only bearer from developer.x.com

# Telegram Bot API (@BotFather) — for public channel/group stats via getChat / getChatMemberCount
TELEGRAM_BOT_TOKEN=

# Cache TTL for social fetches (ms). Default 600000 (10 minutes).
SOCIAL_STATS_CACHE_TTL_MS=600000

# Pi Core Team balance monitor (Horizon polling)
# SNAPSHOT_CRON_ENABLED=false
# HORIZON_BASE_URL=https://horizon.suban.org
# PCT_SCAN_ENABLED=true
# PCT_SCAN_CRON=*/5 * * * *
# PCT_HORIZON_BASE_URL=https://horizon.suban.org
# PCT_SCAN_BATCH_SIZE=500
# PCT_SCAN_CONCURRENCY=8
# PCT_SCAN_DELAY_MS=80
# PCT_HORIZON_TIMEOUT_MS=12000
# PCT_HORIZON_RETRY_ATTEMPTS=5
# PCT_MOVEMENT_PAYMENT_LIMIT=100
# PCT_SCAN_LOCK_STALE_MS=7200000
# CORE_TEAM_IMPORT_REPLACE=true   # import script: wipe core-team-addresses before import (dangerous)
